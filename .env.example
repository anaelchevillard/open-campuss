# Configuration de Campuss. « npm run setup » crée .env à partir de ce fichier, avec des secrets aléatoires.
# Aucune valeur de ce fichier n'est réelle. Ne jamais versionner .env.
# Les fonctions facultatives restent invisibles tant que leurs variables sont vides.

# ===== Obligatoire ==========================================================

# Adresse publique du site, sans barre finale
BASE_URL=http://localhost:3000
# Port local publié par Docker Compose (sur 127.0.0.1 seulement)
CAMPUS_PORT=3000
# Clé des sessions et des secrets chiffrés : au moins 32 caractères aléatoires
SECRET_KEY=
# Premier administrateur, créé au premier démarrage (mot de passe provisoire : npm run admin:password)
ADMIN_EMAIL=admin@example.org
# Nom affiché du premier administrateur
ADMIN_NAME=Administrateur
# Mot de passe de la base PostgreSQL (utilisateur « campus »)
POSTGRES_PASSWORD=
# Compte administrateur de MinIO, jamais utilisé par l'application
MINIO_ROOT_USER=campus-root
# Mot de passe du compte administrateur de MinIO
MINIO_ROOT_PASSWORD=
# Secret du compte MinIO de l'application, limité à son bucket (au moins 8 caractères)
S3_APP_SECRET=

# ===== Développement (npm run dev avec compose.dev.yaml) ====================
# Docker Compose remplace ces valeurs dans le conteneur de l'application.

# Base de compose.dev.yaml, vue depuis la machine
DATABASE_URL=
# MinIO de compose.dev.yaml, vu depuis la machine
S3_ENDPOINT=http://localhost:9000
# Compte MinIO de l'application (créé par deploy/minio-init.sh)
S3_ACCESS_KEY=campus-app
# Même valeur que S3_APP_SECRET
S3_SECRET_KEY=
# Mot de passe provisoire de l'administrateur, en développement
ADMIN_PASSWORD_FILE=./data/admin-initial-password.txt
# Mails vers mailpit (http://localhost:8025) en développement : décommenter les quatre lignes
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_INSECURE=true
# SMTP_FROM=Campuss <campuss@example.org>

# ===== Site (facultatif) ====================================================

# Nom du site dans les mails, l'application d'authentification et les alertes
SITE_NAME=Campuss
# Éditeur affiché dans les mentions légales (vide : « l'administrateur de Campuss »)
LEGAL_PUBLISHER=
# Origine séparée pour les contenus déposés, ex. https://contenu.example.org (vide : même origine)
CONTENT_ORIGIN=
# Établissement desservi, après « de », article compris, ex. l’UFR Lettres d’Exempleville
ORGANIZATION_NAME=
# Surtitre de la page de présentation, ex. UFR Lettres · Exempleville
ORGANIZATION_SHORT=
# Ville, après « à », ex. Exempleville
ORGANIZATION_CITY=
# Université dont le site est indépendant, article compris, ex. l’Université d’Exemple
UNIVERSITY_NAME=

# ===== Inscriptions (facultatif) ============================================

# Domaines étudiants acceptés sans relecture, séparés par des virgules (aussi dans Administration › Réglages)
AUTO_APPROVE_DOMAINS=
# Domaines dont les adresses suivent prenom_nom@… : le nom du compte en est tiré
NAMED_EMAIL_DOMAINS=
# Captcha Cloudflare Turnstile à l'inscription, clé publique (actif avec les deux clés)
TURNSTILE_SITE_KEY=
# Captcha Cloudflare Turnstile, clé secrète
TURNSTILE_SECRET_KEY=

# ===== Mails (facultatif) ===================================================
# Sans SMTP, aucun mail ne part : l'administrateur crée et valide les comptes lui-même.

# Serveur SMTP
SMTP_HOST=
# Port SMTP (465 : TLS direct ; 587 : STARTTLS)
SMTP_PORT=465
# Identifiant SMTP
SMTP_USER=
# Mot de passe SMTP
SMTP_PASSWORD=
# Expéditeur, ex. Campuss <campuss@example.org>
SMTP_FROM=
# Fenêtre de regroupement des mails non urgents, en secondes (600 par défaut)
# MAIL_BATCH_SECONDS=600

# ===== Sécurité et stockage (facultatif) ====================================

# « cf-connecting-ip » seulement si le site n'est joignable QUE par Cloudflare ; sinon vide
TRUSTED_IP_HEADER=
# Antivirus : « clamav », puis docker compose --profile antivirus up -d (environ 1,2 Go de mémoire)
CLAMAV_HOST=
# Port de clamd
CLAMAV_PORT=3310
# Nombre de signalements qui masquent un cours en attendant la modération
REPORT_HIDE_THRESHOLD=3
# Espace de stockage par compte, en Mo (vide : 500)
STORAGE_QUOTA_MB=
# Fichier d'état écrit par votre script de sauvegarde, affiché dans Administration › Système
BACKUP_STATUS_FILE=

# ===== Campuss IA (facultatif) ==============================================
# Toute API compatible OpenAI. Sans clé, les fonctions d'IA n'apparaissent pas.

# Adresse de l'API
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Clé de l'API
AI_API_KEY=
# Modèle principal (transcription, fiches, quiz)
AI_MODEL=gemini-2.5-flash
# Modèle des petites tâches (classement d'un dépôt) ; vide : AI_MODEL
AI_MODEL_LIGHT=
# Plafond quotidien de jetons pour tout le site (2 000 000 par défaut)
# AI_DAILY_TOKEN_BUDGET=2000000

# ===== Notifications push (facultatif) ======================================

# Clé publique VAPID : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# Clé privée VAPID
VAPID_PRIVATE_KEY=

# ===== Imports (facultatif) =================================================

# Jeton d'intégration Notion, pour l'import de pages publiques
NOTION_TOKEN=
# Connexion Notion par OAuth (dossier connecté), identifiant du client
NOTION_OAUTH_CLIENT_ID=
# Connexion Notion par OAuth, secret du client
NOTION_OAUTH_CLIENT_SECRET=
# Google Docs (voir docs/google-oauth.md), identifiant du client
GOOGLE_OAUTH_CLIENT_ID=
# Google Docs, secret du client
GOOGLE_OAUTH_CLIENT_SECRET=

# ===== Instance de démonstration (facultatif) ================================

# 1 : compte partagé et données fictives (npm run demo:seed). Inscription, changements du compte, export, mails, IA et
# fichiers de plus de 2 Mo sont refusés côté serveur ; tout le site passe en noindex, sans mesure d'audience.
DEMO_MODE=
