# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
app.env


# Fichiers de test volumineux, recréés par tests/make-fixtures.py
tests/fixtures/bomb.zip
tests/fixtures/gros.bin
# Sources de polices : seuls les .woff2 servent au build
fonts/**/*.otf
fonts/**/*.ttf

# Construit par scripts/build-vendor.mjs
/public/vendor/lib/
# Construits par scripts/build-tikz.mjs
/tikz-worker.mjs
/tikz/
/public/vendor/tikz/
/.vendor-entries/

/collab.mjs
/seed-demo.mjs
# Développement : mot de passe provisoire de l'administrateur (ADMIN_PASSWORD_FILE)
/data/

# Secrets et données locales : jamais suivis (seul .env.example l'est)
.env*
!.env.example
app.env
*.dump
*.sql.gz
*.pem
*.key
*.p12
*.sqlite
*.sqlite3
*.db
secrets/
# Outils et sorties locales
bench/
captures/
captures-*/
coverage/
node_modules/
.next/
